<?xml version='1.0' encoding='utf-8'?>
<widget id="ru.redramka.obsdemo" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Obs Demo</name>
    <description>Учебный стенд по наблюдаемости фронтенда: Vue 3 + Quasar + Cordova, коллектор и мок-API</description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application" xmlns:android="http://schemas.android.com/apk/res/android">
        <application android:usesCleartextTraffic="true" />
    </edit-config>
    <platform name="android">
        <preference name="AndroidXEnabled" value="true" />
        <!-- Страница живёт на https://localhost (cordova-android 10+), а коллектор/API — на http:// в локальной сети.
             Без этого WebView блокирует такие запросы как mixed content: MIXED_CONTENT_ALWAYS_ALLOW = 0. -->
        <preference name="MixedContentMode" value="0" />
        <allow-intent href="market:*" />
    </platform>
    <allow-navigation href="about:*" />
</widget>
